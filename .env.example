# Copy file này thành .env rồi điền giá trị.
# Chỉ dùng PUBLISHABLE key — key này public theo thiết kế, nằm trong bundle là bình thường.
# TUYỆT ĐỐI KHÔNG đặt secret key (sb_secret_… hoặc service_role) vào đây.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
